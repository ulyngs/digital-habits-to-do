# Copy to .env for local Windows Store builds (never commit .env).

# Partner Center → Product identity (required for scripts/build-msix.ps1)
WINDOWS_IDENTITY_NAME=ReduceDigitalDistraction.ReDDTodo
WINDOWS_PUBLISHER=CN=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
WINDOWS_PUBLISHER_DISPLAY_NAME=Reduce Digital Distraction

# Optional: Partner Center API submit (usually GitHub Actions secrets only).
# Reuse the same Entra app as ReDD Blocker; set To-Do’s product ID.
# AZURE_AD_TENANT_ID=
# AZURE_AD_APPLICATION_CLIENT_ID=
# AZURE_AD_APPLICATION_SECRET=
# SELLER_ID=
# MS_STORE_PRODUCT_ID=
